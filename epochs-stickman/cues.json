[
{
"t0": 0.0,
"t1": 1.16,
"text": "Минус сорок."
},
{
"t0": 1.16,
"t1": 2.16,
"text": "Ты умираешь."
},
{
"t0": 2.16,
"t1": 4.04,
"text": "Не от холода — от царапины на пальце."
},
{
"t0": 4.04,
"t1": 7.2,
"text": "До антибиотиков двадцать тысяч лет."
},
{
"t0": 7.2,
"t1": 7.68,
"text": "Писк."
},
{
"t0": 7.68,
"t1": 8.52,
"text": "Вспышка."
},
{
"t0": 8.52,
"t1": 9.04,
"text": "Жара."
},
{
"t0": 9.04,
"t1": 10.68,
"text": "Каменная пыль скрипит на зубах."
},
{
"t0": 10.68,
"t1": 13.14,
"text": "Ты пьёшь из Нила — и глотаешь червей."
},
{
"t0": 13.14,
"t1": 13.78,
"text": "Рим."
},
{
"t0": 13.78,
"t1": 15.18,
"text": "Латыни не знаешь — машешь руками."
},
{
"t0": 15.18,
"t1": 16.66,
"text": "Щит на десять кило."
},
{
"t0": 16.66,
"t1": 18.46,
"text": "Напротив — профессионал."
},
{
"t0": 19.06,
"t1": 19.54,
"text": "Стоп."
},
{
"t0": 19.54,
"t1": 20.34,
"text": "Почему ты жив?"
},
{
"t0": 20.34,
"t1": 23.82,
"text": "Сломанный браслет выдёргивает тебя за миг до смерти — и кидает дальше."
},
{
"t0": 23.82,
"t1": 26.450000000000003,
"text": "Без денег, оружия и иммунитета."
},
{
"t0": 26.77,
"t1": 27.69,
"text": "Чёрная смерть."
},
{
"t0": 27.69,
"t1": 29.17,
"text": "Улица воняет нечистотами."
},
{
"t0": 29.17,
"t1": 29.73,
"text": "Вши."
},
{
"t0": 29.73,
"t1": 31.41,
"text": "Одна блоха — и всё."
},
{
"t0": 31.41,
"t1": 34.09,
"text": "Дальше ты будешь мечтать о крысе на обед."
},
{
"t0": 34.09,
"t1": 34.93,
"text": "Корабль Магеллана."
},
{
"t0": 34.93,
"t1": 35.85,
"text": "Цинга."
},
{
"t0": 35.85,
"t1": 38.42,
"text": "Зубы шатаются, старые шрамы снова кровят."
},
{
"t0": 38.42,
"t1": 40.22,
"text": "Крыса на обед — роскошь."
},
{
"t0": 40.38,
"t1": 40.89,
"text": "Лондон."
},
{
"t0": 40.89,
"t1": 42.26,
"text": "Смог режет горло."
},
{
"t0": 42.26,
"t1": 43.66,
"text": "Обои дышат мышьяком."
},
{
"t0": 43.66,
"t1": 45.74,
"text": "Дальше оружием станет сам воздух."
},
{
"t0": 45.74,
"t1": 46.42,
"text": "Верден."
},
{
"t0": 46.42,
"t1": 47.54,
"text": "Грязь по колено."
},
{
"t0": 47.54,
"t1": 48.38,
"text": "Небо воет."
},
{
"t0": 48.38,
"t1": 49.82,
"text": "В окоп ползёт газ."
},
{
"t0": 49.82,
"t1": 50.82,
"text": "Четыре часа."
},
{
"t0": 50.82,
"t1": 51.58,
"text": "Вспышка."
},
{
"t0": 51.58,
"t1": 52.66,
"text": "Обычная улица."
},
{
"t0": 52.66,
"t1": 53.15,
"text": "Тихо."
},
{
"t0": 53.15,
"t1": 53.91,
"text": "Скорая."
},
{
"t0": 53.91,
"t1": 54.83,
"text": "Одна таблетка."
},
{
"t0": 54.83,
"t1": 55.99,
"text": "Стакан чистой воды."
},
{
"t0": 55.99,
"t1": 56.99,
"text": "Браслет гаснет."
},
{
"t0": 56.99,
"t1": 58.51,
"text": "Ты не сильнее предков."
},
{
"t0": 58.51,
"t1": 62.95,
"text": "Тебя спасает невидимая броня — знания миллиардов людей до тебя."
}
]